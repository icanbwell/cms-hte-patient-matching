[[source]]
url = "https://pypi.python.org/simple"
verify_ssl = true
name = "pypi"

[[source]]
name = "alpine-wheels"
# https://github.com/imranq2/alpine-wheels/
url = "https://imranq2.github.io/alpine-wheels/docs/"
verify_ssl = true

[packages]
# PyJWT is needed for decoding and verifying IAL2 JWT tokens
# cryptography is needed for RSA signature verification of JWTs
pyjwt = "*"
cryptography = "*"
# rapidfuzz is needed for string distance algorithms in matching
rapidfuzz = ">=3.9.4"
# usaddress is needed for parsing street addresses
usaddress = ">=0.5.10"
# usaddress-scourgify is needed for normalizing addresses to USPS standard
usaddress-scourgify = ">=0.6.0"
# phonenumbers is needed for E.164 phone number normalization
phonenumbers = ">=8.13.40"
# phonetics is needed for phonetic matching algorithms
phonetics = ">=1.0.5"
# nominally is needed for parsing name components
nominally = ">=1.1.0"
# nicknames is needed for nickname lookup tables
nicknames = ">=1.0.0"
# text-unidecode is needed for diacritic folding
text-unidecode = ">=1.3"
# fhirschemapy is needed for FHIR R4 resource parsing and serialization
fhirschemapy = "*"
# fastapi is needed for the $match HTTP API
fastapi = ">=0.115.0"
# uvicorn is the ASGI server for FastAPI
uvicorn = ">=0.34.0"
# httpx is needed for async HTTP calls to FHIR servers
httpx = ">=0.28.0"
# duckdb is needed for the in-memory patient cache
duckdb = ">=1.2.0"
# apscheduler is needed for scheduled cache refresh
apscheduler = ">=3.10.0"

[dev-packages]
setuptools=">=60.9.3"
wheel = ">=0.43.0"
twine=">=4.0.2"
pre-commit=">=3.6.1"
autoflake=">=2.2.0"
mypy = ">=1.8.0"
pytest = ">=8.1.1"
pytest-asyncio = ">=0.23.6"
black = ">=24.2.0"
# bandit is needed for security checks
bandit = ">=1.8.3"
# ruff is needed for linting
ruff = ">=0.11.5"
# pytest-cov is needed for measuring test coverage
pytest-cov = ">=6.1.1"

# These dependencies are required for pipenv-setup.  They conflict with ones above, so we install these
# only when running pipenv-setup

[pipenvsetup]
# vistr is needed for visualizing the dependency graph
vistir=">=0.6.1, <0.7.0" # https://github.com/Madoshakalaka/pipenv-setup/issues/138
# plete is needed for tab completion
plette = "<1.0.0" # https://github.com/Madoshakalaka/pipenv-setup/issues/138
# pipenv-setup is needed for updating setup.py with the dependencies for anyone installing this package
pipenv-setup = ">=3.2.0"
# setuptools >= 81.0.0 has a breaking change that causes pipenv-setup to fail, so we need to pin it to a version <= 80.9.0
setuptools=">=60.9.3, <=80.9.0"

[requires]
python_version = "3.12"

[pipenv]
allow_prereleases = false
